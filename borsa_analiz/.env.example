# Telegram ayarları
# Bot token'ı BotFather'dan alın: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Chat ID: @userinfobot'a mesaj atıp ID'nizi öğrenin
TELEGRAM_CHAT_ID=123456789

# (Opsiyonel) Yapay zekâ destekli detaylı şirket raporu (/rapor komutu) için.
# https://console.anthropic.com adresinden alınır. Boş bırakılırsa bot yine çalışır.
ANTHROPIC_API_KEY=

# (Opsiyonel) Türkiye yıllık enflasyonu (%) — TL büyüme/ROE bununla kıyaslanır
# TR_INFLATION_PCT=30
